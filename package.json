{
  "name": "devast-rpc",
  "productName": "Devast RPC",
  "version": "1.0.0",
  "description": "Discord Rich Presence helper for Devast.io",
  "main": "main.js",
  "author": "Halcyon Discord",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "obfuscate": "node build-tools/obfuscate.js",
    "build:win": "npm run obfuscate && electron-builder --win",
    "build:mac": "npm run obfuscate && electron-builder --mac",
    "build:linux": "npm run obfuscate && electron-builder --linux"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "javascript-obfuscator": "^4.1.1"
  },
  "build": {
    "appId": "com.halcyon.devastrpc",
    "productName": "Devast RPC",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "build/icon.*"
    ],
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "IMREALSS2",
        "repo": "devast-scripts"
      }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Devast RPC"
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }],
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "build/icon.png",
      "category": "Utility"
    }
  }
}
